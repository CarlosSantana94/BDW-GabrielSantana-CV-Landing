{
  "cleanUrls": true,
  "directoryListing": false,
  "trailingSlash": true,
  "headers": [
    { "source": "_astro/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "**/*.@(webp|avif|jpg|png|svg|mp4|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
